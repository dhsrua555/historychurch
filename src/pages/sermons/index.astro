---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CrossMark from '../../components/CrossMark.astro';
import SermonCard from '../../components/SermonCard.astro';
import VideoPlayer from '../../components/VideoPlayer.astro';
import site from '../../data/site.json';
import { byDateDesc, href, longDate } from '../../lib/utils';

const sermons = (await getCollection('sermons')).sort(byDateDesc);
const latest = sermons.find((s) => s.data.category === '주일예배') ?? sermons[0];
const categories = ['주일예배', '수요예배', '금요기도회', '특별예배'].filter((c) => sermons.some((s) => s.data.category === c));
const PAGE = 12;
---

<Base title="설교" description={`${site.name} 주일예배 · 수요예배 · 금요기도회 설교 영상`}>
  <PageHero label="설교 · Sermons" title="말씀으로 쓰는<br />믿음의 역사" lead="주일예배와 수요 히스토리 예배, 금요 미라클 기도회 말씀을 영상으로 다시 보실 수 있습니다.">
    <div class="btn-row hero-actions">
      <a class="btn btn--light" href={site.links.youtube} target="_blank" rel="noopener">유튜브 채널<span class="btn__icon"><CrossMark class="" /></span></a>
    </div>
  </PageHero>

  {
    latest && (
      <section class="section--tight darker">
        <div class="container featured">
          <VideoPlayer id={latest.data.youtube} title={latest.data.title} eager />
          <div class="featured__info">
            <p class="label">
              <CrossMark /> 최근 주일 설교
            </p>
            <p class="muted">{longDate(latest.data.date)}</p>
            <h2 class="h2">{latest.data.title}</h2>
            <p class="featured__meta muted">{[latest.data.scripture, latest.data.preacher].filter(Boolean).join(' · ')}</p>
            <a class="text-link" href={href(`/sermons/${latest.id}/`)}>
              본문 말씀과 함께 보기 →
            </a>
          </div>
        </div>
      </section>
    )
  }

  <section class="section paper">
    <div class="container" data-filter-list data-page={PAGE}>
      <div class="tabs" role="group" aria-label="예배 종류">
        <button type="button" aria-pressed="true" data-filter="all">전체</button>
        {categories.map((c) => <button type="button" aria-pressed="false" data-filter={c}>{c}</button>)}
      </div>

      <div class="sermon-grid">
        {sermons.map((s) => <SermonCard sermon={s} />)}
      </div>

      <div class="more-wrap">
        <button type="button" class="btn btn--ghost" data-more>더 보기<span class="btn__icon"><CrossMark class="" /></span></button>
      </div>
      <p class="archive-note muted">
        이전 설교는 <a href={site.links.youtube} target="_blank" rel="noopener">히스토리교회 유튜브 채널</a>에서 보실 수 있습니다.
      </p>
    </div>
  </section>
</Base>

<style>
  .hero-actions {
    margin-top: 36px;
  }

  .featured {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(28px, 4vw, 64px);
    align-items: center;
  }

  .featured__info {
    display: grid;
    gap: 10px;
    justify-items: start;
  }

  .featured__info .label {
    margin-bottom: 8px;
  }

  .featured__meta {
    margin-bottom: 12px;
  }

  @media (max-width: 960px) {
    .featured {
      grid-template-columns: 1fr;
    }
  }

  .sermon-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(36px, 4vw, 56px) clamp(20px, 2.4vw, 32px);
  }

  @media (max-width: 960px) {
    .sermon-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .sermon-grid {
      grid-template-columns: 1fr;
    }
  }

  .archive-note {
    margin-top: 40px;
    text-align: center;
    font-size: 0.93rem;
  }

  .archive-note a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>

<script>
  import { setupFilterList } from '../../lib/filter-list';
  document.querySelectorAll<HTMLElement>('[data-filter-list]').forEach(setupFilterList);
</script>
