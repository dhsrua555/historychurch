---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CrossMark from '../components/CrossMark.astro';
import site from '../data/site.json';
import { REPORT_ENDPOINT } from '../lib/services';

const types = ['화면이 이상해요', '내용이 틀려요', '영상·링크가 안 돼요', '기타'];
---

<Base title="오류 제보" description="홈페이지에서 이상한 점을 발견하셨나요? 알려 주시면 빠르게 고치겠습니다.">
  <PageHero label="오류 제보 · Report" title="이상한 점을<br />알려 주세요" lead="화면이 깨지거나, 내용이 틀리거나, 영상이 안 나오는 등 홈페이지에서 불편한 점을 알려 주시면 빠르게 고치겠습니다. 로그인하지 않아도 됩니다." />

  <section class="section paper">
    <div class="container narrow">
      {
        REPORT_ENDPOINT ? (
          <form class="report" data-report data-endpoint={REPORT_ENDPOINT} novalidate>
            <fieldset class="report__field">
              <legend>어떤 문제인가요?</legend>
              <div class="chips">
                {types.map((t, i) => (
                  <label class="chip">
                    <input type="radio" name="type" value={t} checked={i === 0} />
                    <span>{t}</span>
                  </label>
                ))}
              </div>
            </fieldset>

            <label class="report__field">
              <span class="report__label">어느 페이지에서 보셨나요?</span>
              <input type="text" name="page" maxlength="300" placeholder="예) 설교 페이지, 홈 화면" data-page />
            </label>

            <label class="report__field">
              <span class="report__label">무엇이 문제인가요? <b>*</b></span>
              <textarea name="message" rows="6" maxlength="3000" required placeholder="보신 그대로 편하게 적어 주세요. 예) 휴대폰에서 설교 영상이 재생되지 않아요."></textarea>
            </label>

            <label class="report__field">
              <span class="report__label">연락처 (선택)</span>
              <input type="text" name="contact" maxlength="200" placeholder="답변이 필요하시면 전화번호나 이메일을 남겨 주세요" />
              <span class="report__hint">남기신 연락처는 홈페이지 관리자만 볼 수 있습니다.</span>
            </label>

            <!-- 스팸 방지용 숨은 칸: 사람은 보이지 않아 비워 둡니다 -->
            <label class="report__trap" aria-hidden="true">
              웹사이트 <input type="text" name="website" tabindex="-1" autocomplete="off" />
            </label>

            <div class="report__actions">
              <button type="submit" class="btn" data-submit>
                제보 보내기
                <span class="btn__icon">
                  <CrossMark class="" />
                </span>
              </button>
              <p class="report__status" role="status" aria-live="polite" data-status />
            </div>
          </form>
        ) : (
          <div class="report-fallback">
            <p class="h3">아래 연락처로 알려 주세요.</p>
            <p class="lead">
              전화 <a href={`tel:${site.phone}`}>{site.phone}</a>
              <br />
              이메일 <a href={`mailto:${site.email}`}>{site.email}</a>
            </p>
          </div>
        )
      }

      <div class="report-done" hidden data-done>
        <p class="label">
          <CrossMark /> 접수되었습니다
        </p>
        <p class="h2">제보해 주셔서 감사합니다.</p>
        <p class="lead">확인하고 빠르게 고치겠습니다.</p>
        <a class="text-link" href={import.meta.env.BASE_URL}>
          홈으로 →
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .report {
    display: grid;
    gap: 36px;
  }

  .report__field {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .report__field legend,
  .report__label {
    padding: 0;
    margin-bottom: 2px;
    font-weight: 650;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }

  .report__label b {
    color: var(--green-600);
  }

  .report input[type='text'],
  .report textarea {
    width: 100%;
    padding: 16px 18px;
    border: 0;
    border-radius: 14px;
    background: var(--cream);
    box-shadow: inset 0 0 0 1px var(--line);
    font: inherit;
    color: var(--ink);
    transition: box-shadow 0.3s var(--ease), background-color 0.3s var(--ease);
  }

  .report textarea {
    resize: vertical;
    min-height: 160px;
    line-height: 1.7;
  }

  .report input[type='text']:focus,
  .report textarea:focus {
    outline: none;
    background: #fff;
    box-shadow: inset 0 0 0 2px var(--green);
  }

  .report__hint {
    font-size: 0.88rem;
    color: var(--muted);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .chip span {
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--line-strong);
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    transition: background-color 0.3s var(--ease), color 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }

  .chip input:checked + span {
    background: var(--ink);
    color: var(--paper);
    box-shadow: none;
  }

  .chip input:focus-visible + span {
    outline: 2px solid var(--gold);
    outline-offset: 3px;
  }

  .report__trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .report__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
  }

  .report__status {
    color: var(--ink-2);
    font-size: 0.95rem;
  }

  .report__status.is-error {
    color: #a33a2a;
  }

  .report-done {
    display: grid;
    gap: 14px;
    justify-items: start;
  }

  .report-fallback a {
    color: var(--green);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-report]');
  if (form) {
    const startedAt = Date.now();
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const done = document.querySelector<HTMLElement>('[data-done]')!;

    // 어느 페이지에서 왔는지 자동으로 채웁니다 (푸터의 '오류 제보' 링크가 ?from= 을 붙여 줍니다).
    const from = new URLSearchParams(location.search).get('from');
    if (from) form.querySelector<HTMLInputElement>('[data-page]')!.value = from;

    const say = (text: string, error = false) => {
      status.textContent = text;
      status.classList.toggle('is-error', error);
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const message = String(data.get('message') ?? '').trim();
      if (message.length < 5) {
        say('무엇이 문제인지 조금만 더 적어 주세요.', true);
        form.querySelector('textarea')!.focus();
        return;
      }
      submit.disabled = true;
      say('보내는 중…');
      try {
        const res = await fetch(form.dataset.endpoint!, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            type: data.get('type'),
            page: data.get('page'),
            message,
            contact: data.get('contact'),
            website: data.get('website'),
            viewport: `${window.innerWidth}x${window.innerHeight}`,
            elapsed: Date.now() - startedAt,
          }),
        });
        if (res.status === 429) throw new Error('잠시 후 다시 시도해 주세요. (짧은 시간에 너무 많이 보냈어요)');
        if (!res.ok) throw new Error('전송에 실패했습니다. 잠시 후 다시 시도해 주세요.');
        form.hidden = true;
        done.hidden = false;
        done.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch (err) {
        say(err instanceof Error && err.message.startsWith('잠시') ? err.message : '전송에 실패했습니다. 잠시 후 다시 시도해 주세요.', true);
        submit.disabled = false;
      }
    });
  }
</script>
