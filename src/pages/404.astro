---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CrossMark from '../components/CrossMark.astro';
import { href } from '../lib/utils';
---

<Base title="페이지를 찾을 수 없습니다">
  <PageHero label="404" title="찾으시는 페이지가<br />없습니다" lead="주소가 바뀌었거나 삭제된 페이지일 수 있습니다.">
    <div class="btn-row actions">
      <a class="btn btn--light" href={href('/')}>홈으로<span class="btn__icon"><CrossMark class="" /></span></a>
      <a class="btn btn--ghost" href={href('/sermons/')}>설교 보기<span class="btn__icon"><CrossMark class="" /></span></a>
    </div>
  </PageHero>
</Base>

<style>
  .actions {
    margin-top: 40px;
  }
</style>
